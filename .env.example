# ==============================================================================
# NEWSPULSE AI — CONFIGURATION TEMPLATE
# Copy to .env for local overrides. NEVER commit actual keys to source control!
# ==============================================================================

# Application Environment (local | ec2 | production)
NEWSPULSE_ENV=local

# Execution Mode: local uses local filesystem & spark local mode;
# aws uses real Amazon S3 and optionally EC2 instance profile / IAM keys.
EXECUTION_MODE=local

# Amazon Web Services Configuration (Optional for local mode)
# When deployed on EC2 with an IAM Instance Profile, leave these empty.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=newspulse-ai-storage

# Apache Spark Settings
SPARK_APP_NAME=NewsPulse-AI-Engine
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g
SPARK_LOG_LEVEL=WARN

# Storage & Cache Paths (Relative or Absolute)
LOCAL_DATA_DIR=data
LOCAL_MODELS_DIR=models
LOCAL_JOBS_DB=data/jobs_audit.db

# Active ML Model Artifact
ACTIVE_MODEL_VERSION=v1.0.0-spark-lr
